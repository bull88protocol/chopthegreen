# dependencies
node_modules/

# Expo
.expo/
dist/
dist-*/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Signing credentials — NEVER commit. Back these up separately.
credentials/
*.keystore

# Built release artifacts
dist-release/

# Scratch web export used by scripts/make-screenshots.py
.screenshot-build/

# Scratch paste of the Firebase console's config snippet. Its values belong in
# app.json; keeping the raw drop out of git avoids committing it twice.
firebase.block
